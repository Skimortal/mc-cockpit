{
  "manifest_version": 3,
  "name": "MOST Connect – LPN-Helfer (Manhattan)",
  "version": "0.24",
  "description": "Autopilot für die Manhattan LPN-Erstellung. Füllt die Maske und stoppt vor dem Speichern/Drucken.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.aldi-sued.com/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "LPN-Helfer",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["*://*.aldi-sued.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN",
      "js": ["src/page-bridge.js"]
    },
    {
      "matches": ["*://*.aldi-sued.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["src/content.js"]
    }
  ]
}
